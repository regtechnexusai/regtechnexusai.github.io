# Copy to .env locally. Never commit the populated .env file.
POSTGRES_DB=mukul_quiz_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-password
MUKUL_API_PASSWORD=replace-with-a-different-long-random-runtime-password
DATABASE_URL=postgresql://mukul_api:replace-with-a-different-long-random-runtime-password@db:5432/mukul_quiz_staging
ADMIN_API_TOKEN=replace-with-a-long-random-token
